<?xml version="1.0" encoding="utf-8"?>
<rolemap>
  <permissions>
    <permission acquire="True"
                name="collective.polls: Add poll"
    >
      <role name="Manager" />
      <role name="Site Administrator" />
      <role name="Owner" />
      <role name="Contributor" />
    </permission>
    <permission acquire="True"
                name="collective.polls: Close poll"
    >
      <role name="Manager" />
      <role name="Site Administrator" />
      <role name="Reviewer" />
    </permission>
    <permission acquire="False"
                name="collective.polls: Vote"
    />
  </permissions>
</rolemap>

<configure xmlns="http://namespaces.zope.org/zope">

  <!-- Serializers -->

  <utility
      factory=".summary.JSONSummarySerializerMetadata"
      name="collective.polls.summary_serializer_metadata"
      />

  <!-- The @poll payload, shared by the @poll and @vote services. -->
  <adapter factory=".poll.PollStateSerializer" />

</configure>

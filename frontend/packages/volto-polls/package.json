    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "@testing-library/react": "^16.2.0",
    "release-it": "^19.0.5",
    "vitest": "^3.1.2",
    "@storybook/react": "^8.0.4",
    "@types/react-redux": "^7.1.34",
